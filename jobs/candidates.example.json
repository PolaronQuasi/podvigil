    },
    {
      "gpu_id": "NVIDIA RTX PRO 4500 Blackwell",
      "data_center_id": "EU-RO-1",
      "max_compute_usd_per_hour": 0.8,
      "max_compute_usd": 0.14
    },
    {
      "gpu_id": "NVIDIA GeForce RTX 4090",
      "data_center_id": "EU-RO-1",
      "max_compute_usd_per_hour": 1.0,
