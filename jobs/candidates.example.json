  "gpu_count": 1,
  "min_cuda_version": "12.8",
  "disk_gb": 30,
  "volume_gb": 10,
  "volume_type": "STANDARD",
  "self_termination_probe": true,
  "self_termination_grace_seconds": 60,
  "max_runtime_seconds": 600,
  "startup_timeout_seconds": 240,
  "finalize_grace_seconds": 60,
  "required_artifacts": ["metrics.json"],
  "command": [
    "python3",
    "-u",
    "-c",
    "import json,os,pathlib,torch; assert torch.cuda.is_available(), 'CUDA unavailable'; x=torch.randn(1024,1024,device='cuda'); y=x@x; torch.cuda.synchronize(); p=pathlib.Path(os.environ['PODVIGIL_OUTPUT_DIR']); (p/'metrics.json').write_text(json.dumps({'gpu':torch.cuda.get_device_name(0),'mean':y.mean().item()})); print('CUDA smoke test completed',flush=True)"
  ],
  "inputs": []
}
