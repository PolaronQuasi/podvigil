{
  "cloud": "SECURE",
  "image": "runpod/pytorch:1.0.2-cu1281-torch280-ubuntu2404",
  "candidates": [
    {
      "gpu_id": "NVIDIA GeForce RTX 3090",
      "data_center_id": "EU-CZ-1",
      "max_compute_usd_per_hour": 0.56,
